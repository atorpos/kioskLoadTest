<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Kiosk token + enquire number - 60 rps / 5 min (PRODUCTION)">
      <stringProp name="TestPlan.comments">Production load test for the kiosk flow in KioskTOkenHelper.java -> KioskEnquireNumHelper.java.
Each iteration is one flow:
  01 POST /salesop/kiosk/KioskAuthentication  (KioskTokenRequest)          -> extracts tokenID
  02 POST /salesop/kiosk/KioskNumberEnquiry   (KioskEnquireNumberRequest)  -> sends that tokenID
Step 02 is skipped when step 01 fails (no token), as the app would.

Target: 60 flows/sec = 60 req/sec on EACH endpoint (120 HTTP calls/sec in total).
  5 min (default)  = 18,000 token + 18,000 enquiry requests
  10 min           = add -Jduration=600  (36,000 + 36,000)
  If "60 req/sec" means both calls together, run with -Jrps=30.
The Constant Throughput Timer under step 01 sets the pace (rps x 60 per minute).
150 threads is deliberately oversized (2.5 s budget per flow) so the timer, not the thread pool, sets the pace.

Run headless to generate HTML Graphs:
  jmeter -n -t kioskTokenEnquireLoadTest.jmx -l results.jtl -e -o HTML_Report/

Smoke test first (1 flow/sec for 20 sec):
  jmeter -n -t kioskTokenEnquireLoadTest.jmx -l smoke.jtl -Jrps=1 -Jthreads=2 -Jrampup=1 -Jduration=20

Override from CLI (defaults shown):
  -Jrps=60 -Jthreads=150 -Jrampup=30 -Jduration=300
  -Jkiosk_num=SMP1 -Jinput_num=91519417 -Jauth=eyJ...
  -Jok_result_code=0   (optional: once you know the success resultCode, samples with any other resultCode fail)
  -Jhost=tykapi.hksmartone.com -Jbase_path=/salesop/kiosk -Jprotocol=https -Jport=443

UAT dry run instead of production:
  -Jhost=tykapi-u.hksmartone.com -Jbase_path=/salesop/uat/kiosk -Jauth=&lt;staging Auth_id from KioskTOkenHelper.java&gt;</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Global Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="AUTH_ID" elementType="Argument">
            <stringProp name="Argument.name">AUTH_ID</stringProp>
            <stringProp name="Argument.value">${__P(auth,eyJvcmciOiI2NTcxMzJkNTc2NzRjZjY2YmE3MTc2NDIiLCJpZCI6IjA0YmI3YWUxMDI2ODQ3ODVhMzAyZjJlOWI5MzA4NmE4IiwiaCI6Im11cm11cjY0In0=)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Auth_id header - production value from KioskTOkenHelper / KioskEnquireNumHelper</stringProp>
          </elementProp>
          <elementProp name="KIOSK_NUM" elementType="Argument">
            <stringProp name="Argument.name">KIOSK_NUM</stringProp>
            <stringProp name="Argument.value">${__P(kiosk_num,SMP1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">kioskNum - STCare: SMP1, MyAccount: MYP1 (KioskTokenHelper.KIOSK_NUM_CARE)</stringProp>
          </elementProp>
          <elementProp name="INPUT_NUM" elementType="Argument">
            <stringProp name="Argument.name">INPUT_NUM</stringProp>
            <stringProp name="Argument.value">${__P(input_num,91519417)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">inputNum sent to KioskNumberEnquiry (sCustNum in KioskEnquireNumHelper)</stringProp>
          </elementProp>
          <elementProp name="BASE_PATH" elementType="Argument">
            <stringProp name="Argument.name">BASE_PATH</stringProp>
            <stringProp name="Argument.value">${__P(base_path,/salesop/kiosk)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Production: /salesop/kiosk   UAT: /salesop/uat/kiosk</stringProp>
          </elementProp>
          <elementProp name="OK_RESULT_CODE" elementType="Argument">
            <stringProp name="Argument.name">OK_RESULT_CODE</stringProp>
            <stringProp name="Argument.value">${__P(ok_result_code,[^&lt;]*)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">resultCode counted as success (regex). Default [^&lt;]* = any value, just must be present</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <intProp name="HTTPSampler.connect_timeout">5000</intProp>
        <intProp name="HTTPSampler.response_timeout">30000</intProp>
        <stringProp name="HTTPSampler.domain">${__P(host,tykapi.hksmartone.com)}</stringProp>
        <stringProp name="HTTPSampler.port">${__P(port,443)}</stringProp>
        <stringProp name="HTTPSampler.protocol">${__P(protocol,https)}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.implementation"></stringProp>
      </ConfigTestElement>
      <hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager (both steps)" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">text/xml; charset=UTF-8</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Auth_id</stringProp>
            <stringProp name="Header.value">${AUTH_ID}</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Kiosk flow: token -&gt; enquire number" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,150)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,30)}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,300)}</stringProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 2xx (both steps)" enabled="true">
          <collectionProp name="Asserion.test_strings">
            <stringProp name="49015874">2\d\d</stringProp>
          </collectionProp>
          <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
          <boolProp name="Assertion.assume_success">false</boolProp>
          <intProp name="Assertion.test_type">1</intProp>
          <stringProp name="Assertion.custom_message"></stringProp>
        </ResponseAssertion>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="01 KioskTokenRequest (KioskAuthentication)" enabled="true">
          <stringProp name="HTTPSampler.path">${BASE_PATH}/KioskAuthentication</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;
&lt;soapenv:Envelope xmlns:soapenv=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:kio=&quot;http://kiosk.fes/&quot;&gt;
  &lt;soapenv:Header/&gt;
  &lt;soapenv:Body&gt;
    &lt;kio:KioskTokenRequest&gt;
      &lt;arg0&gt;
        &lt;kioskNum&gt;${KIOSK_NUM}&lt;/kioskNum&gt;
      &lt;/arg0&gt;
    &lt;/kio:KioskTokenRequest&gt;
  &lt;/soapenv:Body&gt;
&lt;/soapenv:Envelope&gt;</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="SOAPAction (step 01 only, as in KioskTokenHelper)" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">SOAPAction</stringProp>
                <stringProp name="Header.value">http://kiosk.fes/Authentication/KioskTokenRequestRequest</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Hold 60 flows/sec (rps x 60 per min, per thread group)" enabled="true">
            <stringProp name="TestPlan.comments">Paces step 01 only, so each flow (token + enquiry) starts at the target rate and step 02 follows right after its token.
Mode &quot;all active threads in current thread group&quot;: each of the 150 threads waits 150 x 16.67 ms = 2500 ms between flows = exactly 60/sec.
The (shared) modes round 1000/60 ms to 17 ms and top out at ~58.8/sec, so they are not used here.</stringProp>
            <intProp name="calcMode">2</intProp>
            <stringProp name="throughput">${__jexl3(${__P(rps,60)} * 60)}</stringProp>
          </ConstantThroughputTimer>
          <hashTree/>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Extract tokenID into TOKEN_ID" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">false</stringProp>
            <stringProp name="RegexExtractor.refname">TOKEN_ID</stringProp>
            <stringProp name="RegexExtractor.regex">&lt;tokenID&gt;([^&lt;]+)&lt;/tokenID&gt;</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NO_TOKEN</stringProp>
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            <stringProp name="RegexExtractor.match_number">1</stringProp>
          </RegexExtractor>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert tokenID returned" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="-235897570">&lt;tokenID&gt;[^&lt;]+&lt;/tokenID&gt;</stringProp>
              <stringProp name="-1847055489">&lt;resultCode&gt;${OK_RESULT_CODE}&lt;/resultCode&gt;</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
            <stringProp name="Assertion.custom_message"></stringProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Only if step 01 returned a token" enabled="true">
          <stringProp name="IfController.condition">${JMeterThread.last_sample_ok}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="02 KioskEnquireNumberRequest (KioskNumberEnquiry)" enabled="true">
            <stringProp name="HTTPSampler.path">${BASE_PATH}/KioskNumberEnquiry</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;
&lt;soapenv:Envelope xmlns:soapenv=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:kio=&quot;http://kiosk.fes/&quot;&gt;
  &lt;soapenv:Header/&gt;
  &lt;soapenv:Body&gt;
    &lt;kio:KioskEnquireNumberRequest&gt;
      &lt;arg0&gt;
        &lt;kioskNum&gt;${KIOSK_NUM}&lt;/kioskNum&gt;
        &lt;tokenID&gt;${TOKEN_ID}&lt;/tokenID&gt;
        &lt;inputNum&gt;${INPUT_NUM}&lt;/inputNum&gt;
      &lt;/arg0&gt;
    &lt;/kio:KioskEnquireNumberRequest&gt;
  &lt;/soapenv:Body&gt;
&lt;/soapenv:Envelope&gt;</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert resultCode returned" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="-1847055489">&lt;resultCode&gt;${OK_RESULT_CODE}&lt;/resultCode&gt;</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">2</intProp>
              <stringProp name="Assertion.custom_message"></stringProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
      <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree (DEBUG - keep disabled for the real run)" enabled="false">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <dataType>true</dataType>
            <encoding>false</encoding>
            <assertions>true</assertions>
            <subresults>true</subresults>
            <responseData>false</responseData>
            <samplerData>false</samplerData>
            <xml>false</xml>
            <fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders>
            <requestHeaders>false</requestHeaders>
            <responseDataOnError>true</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes>
            <sentBytes>true</sentBytes>
            <threadCounts>true</threadCounts>
            <idleTime>true</idleTime>
            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename"></stringProp>
      </ResultCollector>
      <hashTree/>
      <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <dataType>true</dataType>
            <encoding>false</encoding>
            <assertions>true</assertions>
            <subresults>true</subresults>
            <responseData>false</responseData>
            <samplerData>false</samplerData>
            <xml>false</xml>
            <fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders>
            <requestHeaders>false</requestHeaders>
            <responseDataOnError>true</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes>
            <sentBytes>true</sentBytes>
            <threadCounts>true</threadCounts>
            <idleTime>true</idleTime>
            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename"></stringProp>
      </ResultCollector>
      <hashTree/>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
